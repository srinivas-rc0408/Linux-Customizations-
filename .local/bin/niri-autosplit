#!/usr/bin/env python3
# Evenly split tiled columns on a workspace when its column count changes.
# Resizes by window id, so focus never jumps between windows.
import json, subprocess

def query(what):
    out = subprocess.run(["niri", "msg", "--json", what], capture_output=True, text=True).stdout
    return json.loads(out) if out else []

last = {}

def rebalance():
    try:
        wins = query("windows")
    except Exception:
        return
    per_ws = {}
    for w in wins:
        if w.get("is_floating") or w.get("workspace_id") is None:
            continue
        pos = (w.get("layout") or {}).get("pos_in_scrolling_layout")
        per_ws.setdefault(w["workspace_id"], {}).setdefault(pos[0] if pos else ("w", w["id"]), w["id"])
    for ws, cols in per_ws.items():
        n = len(cols)
        if last.get(ws) == n:
            continue
        last[ws] = n
        if not 1 <= n <= 3:
            continue
        width = {1: "100%", 2: "50%", 3: "33.333%"}[n]
        for wid in cols.values():
            subprocess.run(["niri", "msg", "action", "set-window-width", "--id", str(wid), width],
                           capture_output=True)

rebalance()
proc = subprocess.Popen(["niri", "msg", "--json", "event-stream"], stdout=subprocess.PIPE, text=True)
for line in proc.stdout:
    if line.startswith('{"WindowOpenedOrChanged') or line.startswith('{"WindowClosed') or '"WindowsChanged' in line[:20]:
        rebalance()
