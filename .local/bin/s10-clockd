#!/usr/bin/env python3
"""
s10-clockd — waybar clock pill with a pointer-tracking eye.

  pointer moving        -> eyes follow the movement direction (with blinks)
  pointer idle >= 1.8 s -> eyes fade out, time fades in (time 7 s / date 3 s)
  single click (USR1)   -> date for 10 s
  double click (<450ms) -> toggle the dashboard

Output: one JSON object per line for a waybar custom module (return-type json).
"""
import json, os, random, select, signal, subprocess, sys, threading, time

IDLE_AFTER   = 2.0    # seconds of stillness before the clock returns
FADE_STEPS   = (35, 60, 82, 100)   # alpha % frames for fade-in
FADE_DT      = 0.045   # seconds per fade frame
TICK         = 1 / 30  # main loop rate
WIDTH        = 12      # fixed visual width so the pill never jumps
CLOCK_ICON   = ""  # nerd-font clock

EYES = {
    "c":  "◉   ◉",
    "l":  "◐   ◐",
    "r":  "◑   ◑",
    "u":  "◓   ◓",
    "d":  "◒   ◒",
    "b":  "─   ─",   # blink
}

state = {
    "last_motion": 0.0,
    "dir": "c",
    "force_date_until": 0.0,
    "last_click": 0.0,
}
lock = threading.Lock()

# ------------------------------------------------------------------ input --
def input_thread():
    try:
        import evdev
        from evdev import ecodes as E
    except ImportError:
        return
    devs = []
    for path in evdev.list_devices():
        try:
            d = evdev.InputDevice(path)
            caps = d.capabilities()
            rel = caps.get(E.EV_REL, [])
            ab = [c[0] if isinstance(c, tuple) else c for c in caps.get(E.EV_ABS, [])]
            keys = caps.get(E.EV_KEY, [])
            if (E.REL_X in rel) or (E.ABS_X in ab and (E.BTN_TOUCH in keys or E.BTN_TOOL_FINGER in keys)):
                devs.append(d)
            else:
                d.close()
        except Exception:
            pass
    if not devs:
        return
    fdmap = {d.fd: d for d in devs}
    vx = vy = 0.0
    last_abs = {}
    while True:
        r, _, _ = select.select(list(fdmap), [], [], 1.0)
        for fd in r:
            d = fdmap[fd]
            try:
                for ev in d.read():
                    dx = dy = 0
                    if ev.type == E.EV_REL:
                        if ev.code == E.REL_X: dx = ev.value
                        elif ev.code == E.REL_Y: dy = ev.value
                    elif ev.type == E.EV_ABS and ev.code in (E.ABS_X, E.ABS_Y):
                        key = (fd, ev.code)
                        prev = last_abs.get(key)
                        last_abs[key] = ev.value
                        if prev is not None:
                            delta = ev.value - prev
                            if abs(delta) < 400:   # ignore finger-lift jumps
                                if ev.code == E.ABS_X: dx = delta
                                else: dy = delta
                    elif ev.type == E.EV_KEY and ev.code in (E.BTN_TOUCH, E.BTN_TOOL_FINGER) and ev.value == 0:
                        for k in [k for k in last_abs if k[0] == fd]:
                            del last_abs[k]
                    if dx or dy:
                        vx = vx * 0.75 + dx
                        vy = vy * 0.75 + dy
                        if abs(vx) > abs(vy) * 1.2:
                            dr = "r" if vx > 0 else "l"
                        elif abs(vy) > abs(vx) * 1.2:
                            dr = "d" if vy > 0 else "u"
                        else:
                            dr = "c"
                        with lock:
                            state["last_motion"] = time.monotonic()
                            state["dir"] = dr
            except OSError:
                fdmap.pop(fd, None)
        if not fdmap:
            return

# ---------------------------------------------------------------- signals --
def on_click(*_):
    now = time.monotonic()
    with lock:
        if now - state["last_click"] < 0.45:
            state["last_click"] = 0.0
            state["force_date_until"] = 0.0
            subprocess.Popen([os.path.expanduser("~/.local/bin/s10-dash-toggle")],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            state["last_click"] = now
            state["force_date_until"] = now + 10
            state["last_motion"] = 0.0   # show clock immediately

signal.signal(signal.SIGUSR1, on_click)
signal.signal(signal.SIGUSR2, lambda *_: None)
signal.signal(signal.SIGPIPE, signal.SIG_DFL)

# ----------------------------------------------------------------- output --
last_out = None
def emit(text, cls, alpha=100, width=None):
    global last_out
    pad = max(0, (width or WIDTH) - len(text))
    text = " " * (pad // 2) + text + " " * (pad - pad // 2)
    markup = text.replace("&", "&amp;").replace("<", "&lt;")
    if alpha < 100:
        markup = f'<span alpha="{alpha}%">{markup}</span>'
    out = json.dumps({"text": markup, "class": cls, "tooltip": ""})
    if out != last_out:
        sys.stdout.write(out + "\n")
        sys.stdout.flush()
        last_out = out

def clock_text(now_m):
    t = time.localtime()
    with lock:
        forced = now_m < state["force_date_until"]
    show_date = forced or (int(time.time()) % 10) >= 7
    if show_date:
        return f"{CLOCK_ICON}  " + time.strftime("%a %d %b", t), "date"
    return f"{CLOCK_ICON}  " + time.strftime("%I:%M %p", t), "time"

def fade_in(text, cls):
    for a in FADE_STEPS:
        emit(text, cls, a)
        time.sleep(FADE_DT)

# ------------------------------------------------------------------- main --
def main():
    open("/tmp/s10-clockd.pid","w").write(str(os.getpid()))
    threading.Thread(target=input_thread, daemon=True).start()
    state["last_motion"] = time.monotonic() + 0.8   # leave room for the eyes' wake-up
    mode = None
    shown = None
    next_blink = time.monotonic() + random.uniform(2.5, 5)
    while True:
        now = time.monotonic()
        with lock:
            moving = now - state["last_motion"] < IDLE_AFTER
            d = state["dir"]
        if moving:
            # the drawn eyes (s10-eyes) sit on top of the pill: fade the text out
            if mode != "eye":
                if shown:
                    for a in reversed(FADE_STEPS[:-1]):
                        emit(shown[0], shown[1], a)
                        time.sleep(FADE_DT)
                mode = "eye"
            emit("", "eye", width=5)
        else:
            txt, cls = clock_text(now)
            if mode != "clock" or (shown and shown[1] != cls):
                fade_in(txt, cls)
                mode = "clock"
            shown = (txt, cls)
            emit(txt, cls)
        time.sleep(TICK)

if __name__ == "__main__":
    try:
        main()
    except (BrokenPipeError, KeyboardInterrupt):
        pass
